{
  "name": "multi-gmail-mcp",
  "version": "0.2.0",
  "description": "Model Context Protocol server providing Gmail access across multiple Gmail accounts. Mirrors the standard Gmail MCP connector tool interface, adding an optional `account` selector to every tool.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "multi-gmail-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "auth": "node dist/index.js auth",
    "prepare": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "googleapis": "^144.0.0",
    "open": "^10.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
